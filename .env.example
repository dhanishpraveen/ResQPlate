# Public client configuration for a Supabase development project.
# Copy this file to .env.local and fill in values from the Supabase project API settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional reverse-geocoding endpoint accepting ?lat=<lat>&lon=<lon>.
# If omitted, the prototype uses OpenStreetMap Nominatim with caching and a
# one-request-per-second throttle. Production should use a backend proxy with
# an identifiable User-Agent per Nominatim's usage policy.
VITE_GEOCODING_URL=

# Server-side only. Configure this in the deployed Edge Function environment.
ML_SERVICE_URL=http://127.0.0.1:8000
